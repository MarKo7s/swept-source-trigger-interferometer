 108:main.c        ****         }
 109:main.c        ****         if (tx[0] != '\0') {
 110:main.c        ****             UART_PutString(tx);
 111:main.c        ****         }
 112:main.c        ****     }
 113:main.c        **** 
 114:main.c        ****     freqcounter_WriteCounter(0);
 115:main.c        ****     time_count = 0;
