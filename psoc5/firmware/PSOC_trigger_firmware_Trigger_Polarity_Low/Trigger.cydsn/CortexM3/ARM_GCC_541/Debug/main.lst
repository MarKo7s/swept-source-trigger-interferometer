  60:main.c        **** 
  61:main.c        **** static void apply_divider(uint16_t n)
  62:main.c        **** {
  63:main.c        ****     /* n==1: bypass Counter, route comparator straight to output via mux.
  64:main.c        ****      * n>=2: divide with Counter (period=n, ~50% duty via compare). */
  65:main.c        ****     if (n <= 1u) {
  66:main.c        ****         muxSel_Write(MUX_CH_RAW);
  67:main.c        ****     } else {
  68:main.c        ****         muxSel_Write(MUX_CH_DIV);
  69:main.c        ****         Counter_WritePeriod((uint16)n);
  70:main.c        ****         Counter_WriteCompare((uint16)((n / 2u) - 1u)); /* ~50% duty */
  71:main.c        ****     }
  72:main.c        **** }
  73:main.c        **** 
  74:main.c        **** /* End of laser sweep */
  75:main.c        **** CY_ISR(INT_SW)
  76:main.c        **** {
  77:main.c        ****     /* Timer @ 24 MHz: 24 ticks = 1 us (enable/reset by sw) */
  78:main.c        ****     uint32 cnt = Timer_ReadCounter();
  79:main.c        ****     uint32 ticks = Timer_ReadPeriod() - cnt;
  80:main.c        ****     laser_sweep_eTime = (int)(ticks / 24u); // In us
  81:main.c        ****     Timer_WriteCounter(Timer_ReadPeriod());  /* Reset the timer and prepare next sweep */
  82:main.c        ****     trigger_events_count = freqcounter_ReadCounter();
  83:main.c        **** 
  84:main.c        ****     if (laser_sweep_eTime > 0) {
  85:main.c        ****         trigger_frequency = (float)trigger_events_count / ((float)laser_sweep_eTime * 1e-6f); // In
  86:main.c        ****     } else {
  87:main.c        ****         trigger_frequency = 0.0f;
  88:main.c        ****     }
  89:main.c        **** 
  90:main.c        ****     if (notify_mode != 0) {
  91:main.c        ****         switch (notify_mode) {
  92:main.c        ****             case 1:
  93:main.c        ****                 sprintf(tx, "%d\r\n", laser_sweep_eTime);
ARM GAS  C:\Users\MODELA~1\AppData\Local\Temp\cc5Tzkx6.s 			page 5


  94:main.c        ****                 break;
  95:main.c        ****             case 2:
  96:main.c        ****                 sprintf(tx, "%u\r\n", trigger_events_count);
  97:main.c        ****                 break;
  98:main.c        ****             case 3:
  99:main.c        ****                 sprintf(tx, "%f\r\n", trigger_frequency);
 100:main.c        ****                 break;
 101:main.c        ****             case 4:
 102:main.c        ****                 sprintf(tx, "%d %u %f\r\n", laser_sweep_eTime, trigger_events_count, trigger_freque
 103:main.c        ****                 break;
 104:main.c        ****             default:
 105:main.c        ****                 tx[0] = '\0';
 106:main.c        ****                 break;
 107:main.c        ****         }
 108:main.c        ****         if (tx[0] != '\0') {
 109:main.c        ****             UART_PutString(tx);
 110:main.c        ****         }
 111:main.c        ****     }
 112:main.c        **** 
 113:main.c        ****     freqcounter_WriteCounter(0); /* reset after read (no HW reset on this block) */
 114:main.c        **** }
