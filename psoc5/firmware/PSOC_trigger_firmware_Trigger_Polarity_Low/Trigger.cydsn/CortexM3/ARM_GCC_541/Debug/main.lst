  61:main.c        **** static void apply_divider(unsigned n)
  62:main.c        **** {   
  63:main.c        ****     // Attemping to divice by 1 or 0, use direct ouput from comparator
  64:main.c        ****     if (n == 1u || n == 0u) {
  65:main.c        ****         muxSel_Write(MUX_CH_RAW);
  66:main.c        ****     }
  67:main.c        ****     else {
  68:main.c        ****         muxSel_Write(MUX_CH_DIV);
  69:main.c        ****         count = n;
  70:main.c        ****         Counter_WritePeriod(count);
  71:main.c        ****         Counter_WriteCompare((int)(n / 2u) - 1); //Duty Cycle 50%
  72:main.c        ****     }
  73:main.c        **** 
  74:main.c        **** }
  75:main.c        **** 
  76:main.c        **** /* End of laser sweep */
  77:main.c        **** CY_ISR(INT_SW)
  78:main.c        **** {
  79:main.c        ****     int last_time_count = time_count;
  80:main.c        ****     int time_current_counter = Timer_ReadCounter();
  81:main.c        **** 
  82:main.c        ****     time = last_time_count + (time_current_counter / 24);
  83:main.c        ****     total_count = freqcounter_ReadCounter();
  84:main.c        **** 
  85:main.c        ****     if (time > 0) {
  86:main.c        ****         frequency = (float)total_count / ((float)time * 1e-6f);
  87:main.c        ****     } else {
  88:main.c        ****         frequency = 0.0f;
  89:main.c        ****     }
  90:main.c        **** 
  91:main.c        ****     if (notify_mode != 0) {
  92:main.c        ****         switch (notify_mode) {
  93:main.c        ****             case 1:
  94:main.c        ****                 sprintf(tx, "%d\r\n", time);
  95:main.c        ****                 break;
  96:main.c        ****             case 2:
  97:main.c        ****                 sprintf(tx, "%u\r\n", total_count);
  98:main.c        ****                 break;
  99:main.c        ****             case 3:
 100:main.c        ****                 sprintf(tx, "%f\r\n", frequency);
 101:main.c        ****                 break;
 102:main.c        ****             case 4:
 103:main.c        ****                 sprintf(tx, "%d %u %f\r\n", time, total_count, frequency);
 104:main.c        ****                 break;
ARM GAS  C:\Users\MODELA~1\AppData\Local\Temp\ccRwU3XO.s 			page 4


 105:main.c        ****             default:
